# JalRakshak AI — Environment Configuration Template
# Copy to .env:
#   cp .env.example .env

# ==============================================================================
# Database Backend Selection
# Options:
#   - sqlite   : Zero-config local database (default, no cloud needed)
#   - mysql    : Amazon RDS MySQL or local MySQL
#   - dynamodb : Amazon DynamoDB (AWS or local DynamoDB)
# ==============================================================================
DB_BACKEND=sqlite

# Path for SQLite database file (optional, defaults to backend/jalrakshak.db)
SQLITE_PATH=jalrakshak.db

# ==============================================================================
# Amazon RDS MySQL (used only when DB_BACKEND=mysql)
# ==============================================================================
RDS_HOST=jalrakshak.claygkmqe1sb.ap-southeast-2.rds.amazonaws.com
RDS_PORT=3306
RDS_USER=admin
RDS_PASSWORD=
RDS_DATABASE=jalrakshak

# ==============================================================================
# Amazon DynamoDB (used only when DB_BACKEND=dynamodb)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
DYNAMODB_TABLE_PREFIX=jalrakshak
LATEST_WEEK=41

# Point at DynamoDB Local (e.g. docker run -p 8000:8000 amazon/dynamodb-local)
DYNAMODB_ENDPOINT_URL=
AWS_LOCAL_REGION=us-east-1

# ==============================================================================
# API Server Configuration
# ==============================================================================
PORT=8001
CORS_ORIGINS=*
