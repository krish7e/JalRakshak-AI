# JalRakshak AI — environment template. Copy to .env and fill in.
#   cp .env.example .env

# ---- AWS credentials (for real AWS; NOT needed for DynamoDB Local) ----
# Prefer `aws configure` / IAM roles over putting keys in a file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2

# ---- RDS MySQL ("jalrakshak" DB instance) — used when DB_BACKEND=mysql ----
# NOTE: this endpoint is Amazon RDS (MySQL), NOT DynamoDB. It only accepts
# connections from inside its VPC unless it is made Publicly accessible and
# your IP is allowed in its Security Group inbound rule (port 3306).
DB_BACKEND=mysql
RDS_HOST=jalrakshak.claygkmqe1sb.ap-southeast-2.rds.amazonaws.com
RDS_PORT=3306
RDS_USER=admin
RDS_PASSWORD=
RDS_DATABASE=jalrakshak


# ---- DynamoDB tables ----
DYNAMODB_TABLE_PREFIX=jalrakshak
LATEST_WEEK=41

# ---- Point at DynamoDB Local for offline development ----
# Leave EMPTY to use real AWS DynamoDB.
# Set to http://localhost:8000 after running: docker run -d -p 8000:8000 amazon/dynamodb-local
# (or: java -jar DynamoDBLocal.jar -sharedDb  — see README)
DYNAMODB_ENDPOINT_URL=

# dummy creds used only when talking to DynamoDB Local
AWS_LOCAL_REGION=us-east-1

# ---- API ----
# Comma-separated allowed origins for CORS (e.g. http://localhost:5500,https://your-bucket.s3-website... )
CORS_ORIGINS=*
